# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillbridge
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_random_long_string

# Server
PORT=5000

# AWS S3 (for resume uploads) - fill in once you set up AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=skillbridge-resumes

# Gemini API (for AI matching) - reuse your Cognify key or get a new one
GEMINI_API_KEY=
